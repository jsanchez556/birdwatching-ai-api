{
  "name": "birdwatching-ai-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/api/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-runtime.js && npm run verify:artifact",
    "verify:artifact": "node scripts/verify-runtime-artifact.js",
    "start": "npm run start:api",
    "dev": "concurrently -n api,worker -c blue,magenta \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "nodemon src/api/server.js",
    "dev:worker": "nodemon src/workers/index.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/index.js",
    "enrich": "node scripts/enrich.js",
    "ai:evals": "node scripts/runAiEvals.js",
    "ai:evals:portfolio": "node scripts/runAiEvals.js",
    "ai:evals:self-test": "node scripts/runAiScorerSelfTest.js",
    "ai:evals:model-routing": "node scripts/runModelRoutingEvals.js",
    "ai:evals:context": "node scripts/runContextStrategyEvals.js",
    "ai:evals:context:live": "node scripts/runContextStrategyEvals.js --mode live",
    "test:model-routing": "npm test -- --runInBand __tests__/modelRouter.test.js __tests__/reservationIntent.service.test.js __tests__/openaiRetry.utils.test.js __tests__/modelRouteExecution.utils.test.js __tests__/agentPlanningOrchestration.test.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "langsmith": "^0.7.5",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.46.1",
    "redis": "^6.0.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
